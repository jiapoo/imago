    "Unless you decide, they move to Recently Deleted after %lld days." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Entscheidung kommen sie nach %lld Tagen in „Zuletzt gelöscht“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si no decides, pasan a Eliminado tras %lld días."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans décision, ils vont dans Suppressions récentes après %lld jours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza decisione, vanno in Eliminati di recente dopo %lld giorni."
