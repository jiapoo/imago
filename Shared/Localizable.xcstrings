    " %lld not on the iPhone or not fully backed up are left out." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " %lld, die nicht auf dem iPhone oder nicht vollständig gesichert sind, werden ausgelassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Se omiten %lld que no están en el iPhone o no tienen copia completa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " %lld qui ne sont pas sur l’iPhone ou pas entièrement sauvegardés sont laissés de côté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " %lld non presenti sull’iPhone o senza backup completo vengono esclusi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " iPhoneにない、またはバックアップが完了していない%lld項目は除外されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " iPhone에 없거나 백업이 완료되지 않은 %lld개는 제외됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " %lld que não estão no iPhone ou não têm backup completo ficam de fora."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 有 %lld 个不在 iPhone 上或尚未完整备份，已略过。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 有 %lld 個不在 iPhone 上或尚未完整備份，已略過。"
          }
        }
      }
    },
    " %lld selected items aren't fully backed up yet and will be left alone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " %lld ausgewählte Objekte sind noch nicht vollständig gesichert und bleiben unberührt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " %lld ítems seleccionados aún no tienen copia completa y no se tocarán."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " %lld éléments sélectionnés ne sont pas encore entièrement sauvegardés et ne seront pas touchés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " %lld elementi selezionati non hanno ancora un backup completo e non verranno toccati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 選択した%lld項目はまだバックアップが完了していないため、そのままにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 선택한 %lld개 항목은 아직 백업이 완료되지 않아 그대로 둡니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " %lld itens selecionados ainda não têm backup completo e ficarão como estão."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 选中的 %lld 项尚未完整备份，会保持不动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 選取的 %lld 項尚未完整備份，會維持不動。"
          }
        }
      }
    },
    " 1 selected item isn't fully backed up yet and will be left alone." : {
