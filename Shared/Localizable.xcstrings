    "%@ asks you to confirm %@; then they go to Recently Deleted on the iPhone for 30 days. " : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ bittet dich, %2$@ zu bestätigen; dann kommen sie auf dem iPhone 30 Tage lang in „Zuletzt gelöscht“. "
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ te pedirá que confirmes %2$@; luego irán a Eliminado en el iPhone durante 30 días. "
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ vous demandera de confirmer %2$@ ; ils iront ensuite dans Suppressions récentes sur l’iPhone pendant 30 jours. "
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ti chiederà di confermare %2$@; poi andranno in Eliminati di recente sull’iPhone per 30 giorni. "
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@で%2$@確認を求められます。その後、iPhoneの「最近削除した項目」に30日間入ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@에서 %2$@ 확인을 요청합니다. 그 후 iPhone의 최근 삭제된 항목에 30일 동안 보관됩니다. "
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ pede que você confirme %2$@; depois eles vão para Apagados no iPhone por 30 dias. "
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@会请你%2$@确认；之后它们会在 iPhone 的“最近删除”中保留 30 天。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@會請你%2$@確認；之後它們會在 iPhone 的「最近刪除」中保留 30 天。"
          }
        }
      }
    },
