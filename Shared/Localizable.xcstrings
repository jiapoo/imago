    "After %@'s next backup, its library shows up here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach der nächsten Sicherung von %@ erscheint seine Mediathek hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras la próxima copia de %@, su fototeca aparecerá aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après la prochaine sauvegarde de %@, sa photothèque apparaîtra ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo il prossimo backup di %@, qui comparirà la sua libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の次のバックアップ後、ここにそのライブラリが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 다음 백업 후 여기에 보관함이 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois do próximo backup de %@, a fototeca dele aparece aqui."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@下次备份后，它的图库会显示在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@下次備份後，它的圖庫會顯示在這裡。"
          }
        }
      }
    },
    "After %@'s next backup, what's on it shows here." : {
