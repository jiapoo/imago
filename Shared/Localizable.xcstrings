    "Drag a handle to trim. Hold it still for a moment to zoom in and set the cut frame by frame." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe einen Griff zum Kürzen. Halte ihn kurz still, um heranzuzoomen und den Schnitt Bild für Bild zu setzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra un tirador para recortar. Mantenlo quieto un momento para ampliar y ajustar el corte fotograma a fotograma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser une poignée pour raccourcir. Maintenez-la immobile un instant pour zoomer et placer la coupe image par image."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina una maniglia per accorciare. Tienila ferma un attimo per ingrandire e posizionare il taglio fotogramma per fotogramma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハンドルをドラッグしてトリミングします。少し止めておくと拡大され、コマ単位で切る位置を決められます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "핸들을 드래그하여 다듬습니다. 잠시 멈추고 있으면 확대되어 프레임 단위로 자를 위치를 정할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste uma alça para cortar. Segure-a parada por um instante para ampliar e ajustar o corte quadro a quadro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移手柄进行修剪。按住片刻即可放大，逐帧设定剪切点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移控點進行修剪。按住片刻即可放大，逐格設定剪下的位置。"
          }
        }
      }
    },
