    "Only on the device: this is its preview. It's copied to the drive at the next backup." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur auf dem Gerät: Das ist seine Vorschau. Es wird bei der nächsten Sicherung aufs Laufwerk kopiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo en el dispositivo: esta es su vista previa. Se copia al disco en la próxima copia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seulement sur l’appareil : ceci est son aperçu. Il sera copié sur le disque à la prochaine sauvegarde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo sul dispositivo: questa è la sua anteprima. Verrà copiato sul disco al prossimo backup."
