    "1 item doesn't match the copy that was backed up, so it stays on the iPhone. Back up again to replace the copy here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 Objekt stimmt nicht mit der gesicherten Kopie überein, daher bleibt es auf dem iPhone. Sichere erneut, um die Kopie hier zu ersetzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 ítem no coincide con la copia guardada, así que se queda en el iPhone. Haz otra copia para reemplazar la de aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 élément ne correspond pas à la copie sauvegardée, donc il reste sur l’iPhone. Sauvegardez à nouveau pour remplacer la copie ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 elemento non corrisponde alla copia di backup, quindi resta sull’iPhone. Fai di nuovo il backup per sostituire la copia qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1項目はバックアップされたコピーと一致しないため、iPhoneに残ります。ここのコピーを置き換えるには、もう一度バックアップしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1개 항목이 백업된 사본과 일치하지 않아 iPhone에 남습니다. 여기 있는 사본을 대치하려면 다시 백업하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 item não coincide com a cópia com backup, então fica no iPhone. Faça backup de novo para substituir a cópia daqui."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有 1 项与已备份的拷贝不一致，所以仍留在 iPhone 上。再备份一次即可替换这里的拷贝。"
          }
