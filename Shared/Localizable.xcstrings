            "value" : "このMacへのバックアップが完了した項目だけをiPhoneから削除できます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac에 완전히 백업된 항목만 iPhone에서 삭제할 수 있습니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só itens com backup completo neste Mac podem ser apagados do iPhone"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
