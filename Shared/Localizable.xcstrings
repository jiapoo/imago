    "Turn, flip, crop or trim a copy (⌘E or ⌘T). The original stays as it is." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Kopie drehen, spiegeln, beschneiden oder kürzen (⌘E oder ⌘T). Das Original bleibt, wie es ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Girar, voltear, recortar o acortar una copia (⌘E o ⌘T). El original queda como está."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faire pivoter, retourner, recadrer ou raccourcir une copie (⌘E ou ⌘T). L’original reste tel quel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruota, capovolgi, ritaglia o accorcia una copia (⌘E o ⌘T). L’originale resta com’è."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コピーを回転、反転、切り取り、トリミングします（⌘Eまたは⌘T）。オリジナルはそのままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사본을 회전, 뒤집기, 자르기 또는 다듬기합니다(⌘E 또는 ⌘T). 원본은 그대로 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Girar, espelhar, recortar ou cortar uma cópia (⌘E ou ⌘T). O original fica como está."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旋转、翻转、裁剪或修剪一个拷贝（⌘E 或 ⌘T）。原件保持不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旋轉、翻轉、裁切或修剪一份拷貝（⌘E 或 ⌘T）。原始檔維持不變。"
          }
        }
      }
    },
