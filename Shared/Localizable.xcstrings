    },
    "Your Mac didn't accept the code. Open Add iPhone on the Mac and scan again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Mac hat den Code nicht angenommen. Öffne „iPhone hinzufügen“ auf dem Mac und scanne erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu Mac no aceptó el código. Abre Añadir iPhone en el Mac y vuelve a escanear."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre Mac n’a pas accepté le code. Ouvrez Ajouter un iPhone sur le Mac et scannez à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo Mac non ha accettato il codice. Apri Aggiungi iPhone sul Mac e scansiona di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macがコードを受け付けませんでした。Macで「iPhoneを追加」を開き、もう一度スキャンしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac에서 코드를 받아들이지 않았습니다. Mac에서 iPhone 추가를 열고 다시 스캔하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu Mac não aceitou o código. Abra Adicionar iPhone no Mac e escaneie de novo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Mac 没有接受这个代码。请在 Mac 上打开“添加 iPhone”，重新扫描。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Mac 沒有接受這個代碼。請在 Mac 上打開「加入 iPhone」，重新掃描。"
          }
        }
      }
    },
    "Your Mac didn't accept this %@. If you removed it on the Mac, unpair here and pair again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Mac hat dieses %@ nicht angenommen. Wenn du es auf dem Mac entfernt hast, entkopple es hier und kopple es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu Mac no aceptó este %@. Si lo quitaste en el Mac, desenlázalo aquí y vuelve a enlazarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre Mac n’a pas accepté cet %@. Si vous l’avez retiré sur le Mac, dissociez-le ici et jumelez-le à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo Mac non ha accettato questo %@. Se l’hai rimosso sul Mac, dissocialo qui e abbinalo di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macがこの%@を受け付けませんでした。Macで取り除いた場合は、ここでペアリングを解除してからもう一度ペアリングしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac에서 이 %@을(를) 받아들이지 않았습니다. Mac에서 제거했다면 여기에서 페어링을 해제한 후 다시 페어링하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu Mac não aceitou este %@. Se você o removeu no Mac, desemparelhe aqui e emparelhe de novo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Mac 没有接受这部%@。如果你在 Mac 上移除了它，请在这里取消配对后重新配对。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Mac 沒有接受這支%@。如果你在 Mac 上移除了它，請在這裡取消配對後重新配對。"
          }
        }
      }
    },
    "Your Mac sent something unexpected. Make sure both apps are up to date." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Mac hat etwas Unerwartetes gesendet. Achte darauf, dass beide Apps aktuell sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu Mac envió algo inesperado. Comprueba que ambas apps estén actualizadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre Mac a envoyé quelque chose d’inattendu. Vérifiez que les deux apps sont à jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo Mac ha inviato qualcosa di inatteso. Assicurati che entrambe le app siano aggiornate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macから予期しないデータが届きました。両方のアプリが最新であることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac에서 예상치 못한 데이터를 보냈습니다. 두 앱이 모두 최신 버전인지 확인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu Mac enviou algo inesperado. Verifique se os dois apps estão atualizados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Mac 发来了意外的数据。请确认两个 App 都是最新版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Mac 傳來了非預期的資料。請確認兩個 App 都是最新版本。"
          }
        }
      }
    },
    "Your Mac shows this %@ by this name and saves its photos in a folder with the same name." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Mac zeigt dieses %@ unter diesem Namen und sichert seine Fotos in einem Ordner mit demselben Namen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu Mac muestra este %@ con este nombre y guarda sus fotos en una carpeta con el mismo nombre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre Mac affiche cet %@ sous ce nom et enregistre ses photos dans un dossier du même nom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo Mac mostra questo %@ con questo nome e ne salva le foto in una cartella con lo stesso nome."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macはこの%@をこの名前で表示し、同じ名前のフォルダに写真を保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac은 이 %@을(를) 이 이름으로 표시하고, 같은 이름의 폴더에 사진을 저장합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu Mac mostra este %@ com este nome e salva as fotos dele numa pasta com o mesmo nome."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Mac 会用这个名称显示这部%@，并把它的照片存到同名的文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Mac 會用這個名稱顯示這支%@，並把它的照片存到同名的檔案夾。"
          }
        }
      }
    },
    "Your Mac stopped responding." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
