    "Photos didn't add it back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Fotos“ hat es nicht wieder hinzugefügt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos no lo volvió a añadir."
          }
        },
        "fr" : {
          "stringUnit" : {
