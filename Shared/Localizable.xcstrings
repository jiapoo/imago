          "stringUnit" : {
            "state" : "translated",
            "value" : "前回のバックアップが完了しませんでした"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마지막 백업이 완료되지 않았습니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
