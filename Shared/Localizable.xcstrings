    "Imago is open on %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imago ist auf %@ geöffnet"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imago está abierto en %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imago est ouvert sur %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imago è aperto su %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@でImagoが開いています"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 Imago가 열려 있음"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Imago está aberto em %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@上已打开 Imago"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@上已打開 Imago"
          }
        }
      }
    },
    "Imago is open on %@, so these have reached it. Each is done once you approve it there, or right away if it's set to apply changes from this Mac." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imago ist auf %@ geöffnet, daher sind diese dort angekommen. Jede wird ausgeführt, sobald du sie dort bestätigst, oder sofort, wenn Änderungen von diesem Mac automatisch angewendet werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imago está abierto en %@, así que estos ya le han llegado. Cada uno se hace cuando lo apruebas allí, o en el acto si está configurado para aplicar los cambios de este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imago est ouvert sur %@, donc ceux-ci lui sont parvenus. Chacun est fait dès que vous l’approuvez là-bas, ou tout de suite s’il est réglé pour appliquer les modifications de ce Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imago è aperto su %@, quindi queste gli sono arrivate. Ognuna viene eseguita quando la approvi lì, o subito se è impostato per applicare le modifiche da questo Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@でImagoが開いているので、これらはすでに届いています。それぞれ、そちらで承認すると、またはこのMacからの変更を適用する設定ならすぐに実行されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 Imago가 열려 있으므로 이 항목들은 이미 전달되었습니다. 각 항목은 그곳에서 승인하면 실행되며, 이 Mac의 변경 사항을 적용하도록 설정되어 있으면 바로 실행됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Imago está aberto em %@, então estes já chegaram lá. Cada um é feito quando você aprova lá, ou na hora se ele estiver ajustado para aplicar as alterações deste Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@上已打开 Imago，所以这些已经送达。每一项在你于那边同意后完成；如果设为自动应用这台 Mac 的更改，则立即完成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@上已打開 Imago，所以這些已經送達。每一項在你於那邊同意後完成；如果設為自動套用這部 Mac 的更動，則立即完成。"
          }
        }
      }
    },
    "Imago is open on %@: changes go to it right away" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imago ist auf %@ geöffnet: Änderungen gehen sofort dorthin"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imago está abierto en %@: los cambios le llegan al momento"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imago est ouvert sur %@ : les modifications lui parviennent tout de suite"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imago è aperto su %@: le modifiche gli arrivano subito"
          }
        },
