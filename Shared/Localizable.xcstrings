      }
    },
    "On the iPhone but not fully on this Mac yet. They're copied at the next backup; until then they can't be deleted from here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf dem iPhone, aber noch nicht vollständig auf diesem Mac. Sie werden bei der nächsten Sicherung kopiert; bis dahin können sie hier nicht gelöscht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el iPhone, pero aún sin copia completa en este Mac. Se copian en la próxima copia; hasta entonces no se pueden eliminar desde aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur l’iPhone, mais pas encore entièrement sur ce Mac. Ils seront copiés à la prochaine sauvegarde ; d’ici là, ils ne peuvent pas être supprimés d’ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sull’iPhone ma non ancora del tutto su questo Mac. Verranno copiati al prossimo backup; fino ad allora non si possono eliminare da qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneにありますが、まだこのMacへのバックアップが完了していません。次のバックアップでコピーされます。それまではここから削除できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone에 있지만 아직 이 Mac에 완전히 백업되지 않았습니다. 다음 백업 때 복사되며, 그때까지는 여기에서 삭제할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No iPhone, mas ainda sem backup completo neste Mac. Eles são copiados no próximo backup; até lá não podem ser apagados daqui."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iPhone 上，但尚未完整备份到这台 Mac。它们会在下次备份时拷贝；在此之前，不能从这里删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iPhone 上，但尚未完整備份到這部 Mac。它們會在下次備份時拷貝；在那之前，無法從這裡刪除。"
          }
        }
      }
    },
