    },
    " The other %@ are on an iPhone: deleted there once the iPhone agrees, and here then." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Die anderen %@ sind auf einem iPhone: dort gelöscht, sobald das iPhone zustimmt, und dann auch hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Los otros %@ están en un iPhone: se eliminan allí cuando el iPhone lo acepte, y luego aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Les %@ autres sont sur un iPhone : supprimés là-bas quand l’iPhone accepte, puis ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Gli altri %@ sono su un iPhone: eliminati lì quando l’iPhone accetta, e poi qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " ほかの%@項目はiPhoneにあります：iPhoneが承認するとそちらで削除され、その後ここでも削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 나머지 %@개는 iPhone에 있습니다. iPhone이 승인하면 그곳에서 삭제되고, 그 후 여기에서도 삭제됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Os outros %@ estão num iPhone: são apagados lá quando o iPhone aceitar, e depois aqui."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 另外 %@ 项在 iPhone 上：iPhone 同意后会在那边删除，然后这里也删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 另外 %@ 項在 iPhone 上：iPhone 同意後會在那邊刪除，然後這裡也刪除。"
          }
        }
      }
    },
    " The other one is on an iPhone: deleted there once the iPhone agrees, and here then." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Das andere ist auf einem iPhone: dort gelöscht, sobald das iPhone zustimmt, und dann auch hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " El otro está en un iPhone: se elimina allí cuando el iPhone lo acepte, y luego aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " L’autre est sur un iPhone : supprimé là-bas quand l’iPhone accepte, puis ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " L’altro è su un iPhone: eliminato lì quando l’iPhone accetta, e poi qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " ほかの1項目はiPhoneにあります：iPhoneが承認するとそちらで削除され、その後ここでも削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 나머지 1개는 iPhone에 있습니다. iPhone이 승인하면 그곳에서 삭제되고, 그 후 여기에서도 삭제됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " O outro está num iPhone: é apagado lá quando o iPhone aceitar, e depois aqui."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 另外 1 项在 iPhone 上：iPhone 同意后会在那边删除，然后这里也删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 另外 1 項在 iPhone 上：iPhone 同意後會在那邊刪除，然後這裡也刪除。"
          }
        }
      }
    },
