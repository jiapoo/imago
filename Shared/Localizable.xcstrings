          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Mac 沒有回應。"
          }
        }
      }
    },
    "Your Mac's backup drive “%@” isn't connected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Backup-Laufwerk „%@“ deines Mac ist nicht verbunden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El disco de copias de tu Mac, “%@”, no está conectado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le disque de sauvegarde de votre Mac, « %@ », n’est pas connecté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il disco di backup del tuo Mac, “%@”, non è collegato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macのバックアップドライブ“%@”が接続されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac의 백업 드라이브 “%@”이(가) 연결되어 있지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O disco de backup do seu Mac, “%@”, não está conectado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你 Mac 的备份硬盘“%@”未连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你 Mac 的備份硬碟「%@」未連接。"
          }
        }
      }
    },
    "Your photos and videos copy to your own Mac over Wi-Fi, encrypted, at full quality. Nothing goes through the cloud." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Fotos und Videos werden über WLAN auf deinen eigenen Mac kopiert, verschlüsselt und in voller Qualität. Nichts geht über die Cloud."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus fotos y vídeos se copian en tu propio Mac por Wi-Fi, cifrados y con calidad completa. Nada pasa por la nube."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos photos et vidéos sont copiées sur votre propre Mac par Wi-Fi, chiffrées, en pleine qualité. Rien ne passe par le cloud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue foto e i tuoi video vengono copiati sul tuo Mac tramite Wi-Fi, crittografati, alla massima qualità. Niente passa per il cloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真とビデオは、暗号化された状態で、フル画質のままWi-Fi経由で自分のMacにコピーされます。クラウドは一切通りません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진과 비디오가 Wi-Fi를 통해 암호화된 상태로, 원본 화질 그대로 나의 Mac에 복사됩니다. 클라우드를 거치지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas fotos e vídeos são copiados para o seu próprio Mac por Wi-Fi, criptografados e em qualidade total. Nada passa pela nuvem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的照片和视频会通过无线局域网，以加密方式、原始画质拷贝到你自己的 Mac。不经过任何云。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的照片和影片會透過 Wi-Fi，以加密方式、原始畫質拷貝到你自己的 Mac。不經過任何雲端。"
          }
        }
      }
    },
    "Your photos are protected" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Fotos sind geschützt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus fotos están protegidas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos photos sont protégées"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue foto sono al sicuro"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真は守られています"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진이 보호되고 있습니다"
          }
        },
