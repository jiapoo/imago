    "Keep both on the same Wi-Fi. This code works once, and only while this window is open." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte beide im selben WLAN. Dieser Code funktioniert einmal und nur, solange dieses Fenster offen ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén ambos en la misma Wi-Fi. Este código sirve una vez y solo mientras esta ventana está abierta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez les deux sur le même Wi-Fi. Ce code fonctionne une fois, et seulement tant que cette fenêtre est ouverte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni entrambi sulla stessa rete Wi-Fi. Questo codice funziona una volta e solo mentre questa finestra è aperta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "両方を同じWi-Fiに接続してください。このコードは1回だけ、このウインドウが開いている間だけ使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 기기를 같은 Wi-Fi에 두세요. 이 코드는 한 번만, 이 윈도우가 열려 있는 동안에만 작동합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha os dois na mesma rede Wi-Fi. Este código funciona uma vez, e só enquanto esta janela estiver aberta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请让两者连接同一个无线局域网。这个代码只能用一次，且只在这个窗口打开时有效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請讓兩者連接同一個 Wi-Fi。這個代碼只能用一次，且只在這個視窗打開時有效。"
          }
        }
      }
    },
