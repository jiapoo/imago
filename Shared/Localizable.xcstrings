        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "결정하지 않으면 %lld일 후에 최근 삭제된 항목으로 이동합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
