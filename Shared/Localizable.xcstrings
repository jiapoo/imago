    "It's made on %@ when the change reaches it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wird auf %@ ausgeführt, wenn die Änderung dort ankommt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se hace en %@ cuando le llegue el cambio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est fait sur %@ quand la modification lui parvient."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viene eseguita su %@ quando la modifica gli arriva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変更が届いたら%@で実行されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "변경 사항이 전달되면 %@에서 실행됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
