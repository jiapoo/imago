    "%lld items don't match the copy that was backed up, so they stay on the iPhone. Back up again to replace the copy here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Objekte stimmen nicht mit der gesicherten Kopie überein, daher bleiben sie auf dem iPhone. Sichere erneut, um die Kopie hier zu ersetzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld ítems no coinciden con la copia guardada, así que se quedan en el iPhone. Haz otra copia para reemplazar la de aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld éléments ne correspondent pas à la copie sauvegardée, donc ils restent sur l’iPhone. Sauvegardez à nouveau pour remplacer la copie ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld elementi non corrispondono alla copia di backup, quindi restano sull’iPhone. Fai di nuovo il backup per sostituire la copia qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld項目はバックアップされたコピーと一致しないため、iPhoneに残ります。ここのコピーを置き換えるには、もう一度バックアップしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld개 항목이 백업된 사본과 일치하지 않아 iPhone에 남습니다. 여기 있는 사본을 대치하려면 다시 백업하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld itens não coincidem com a cópia com backup, então ficam no iPhone. Faça backup de novo para substituir a cópia daqui."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有 %lld 项与已备份的拷贝不一致，所以仍留在 iPhone 上。再备份一次即可替换这里的拷贝。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有 %lld 項與已備份的拷貝不符，所以仍留在 iPhone 上。再備份一次即可取代這裡的拷貝。"
          }
        }
      }
    },
