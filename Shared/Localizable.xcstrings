    "To let a sleeping Mac accept backups, turn on **Wake for network access** in System Settings › Energy." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit ein schlafender Mac Sicherungen annimmt, schalte **Aufwachen für Netzwerkzugriff** in Systemeinstellungen › Energie ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para que un Mac en reposo acepte copias, activa **Activar para acceso a la red** en Ajustes del Sistema › Energía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour qu’un Mac en veille accepte les sauvegardes, activez **Réactiver pour l’accès au réseau** dans Réglages Système › Énergie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perché un Mac in stop accetti i backup, attiva **Riattiva per l’accesso alla rete** in Impostazioni di Sistema › Energia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スリープ中のMacでバックアップを受けるには、システム設定 › エネルギーで**ネットワークアクセスによってスリープを解除**をオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠자기 중인 Mac이 백업을 받으려면 시스템 설정 › 에너지에서 **네트워크 접근 시 깨우기**를 켜세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para que um Mac em repouso aceite backups, ative **Despertar para acesso à rede** em Ajustes do Sistema › Energia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要让睡眠中的 Mac 接收备份，请在“系统设置”›“节能”中打开**通过网络访问唤醒**。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要讓睡眠中的 Mac 接收備份，請在「系統設定」›「能源」中開啟**網路存取時喚醒**。"
          }
        }
      }
    },
    "To make changes from %@ without asking, turn on “Apply changes from Mac automatically” in Imago." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Änderungen von %@ ohne Nachfrage auszuführen, schalte in Imago „Änderungen vom Mac automatisch anwenden“ ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para hacer los cambios de %@ sin preguntar, activa “Aplicar los cambios del Mac automáticamente” en Imago."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour faire les modifications de %@ sans demander, activez « Appliquer automatiquement les modifications du Mac » dans Imago."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per eseguire le modifiche da %@ senza chiedere, attiva “Applica automaticamente le modifiche dal Mac” in Imago."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@からの変更を確認なしで実行するには、Imagoで“Macからの変更を自動的に適用”をオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 변경 사항을 묻지 않고 실행하려면 Imago에서 “Mac의 변경 사항 자동 적용”을 켜세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para fazer as alterações de %@ sem perguntar, ative “Aplicar alterações do Mac automaticamente” no Imago."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要不经询问就完成来自%@的更改，请在 Imago 中打开“自动应用来自 Mac 的更改”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要不經詢問就完成來自%@的更動，請在 Imago 中開啟「自動套用來自 Mac 的更動」。"
          }
        }
      }
    },
