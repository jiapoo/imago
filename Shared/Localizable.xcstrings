    "The album is deleted on %@; its photos and videos stay in the library, as in Photos. %@ asks you to confirm %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Album wird auf %1$@ gelöscht; seine Fotos und Videos bleiben in der Mediathek, wie in „Fotos“. %2$@ bittet dich, es %3$@ zu bestätigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El álbum se elimina en %1$@; sus fotos y vídeos siguen en la fototeca, como en Fotos. %2$@ te pedirá que lo confirmes %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’album est supprimé sur %1$@ ; ses photos et vidéos restent dans la photothèque, comme dans Photos. %2$@ vous demandera de confirmer %3$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’album viene eliminato su %1$@; le sue foto e i suoi video restano nella libreria, come in Foto. %2$@ ti chiederà di confermare %3$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アルバムを%1$@で削除します。写真とビデオは「写真」と同じくライブラリに残ります。%2$@で%3$@確認を求められます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앨범이 %1$@에서 삭제됩니다. 사진 앱처럼 앨범의 사진과 비디오는 보관함에 유지됩니다. %2$@에서 %3$@ 확인을 요청합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O álbum é apagado em %1$@; as fotos e vídeos dele ficam na fototeca, como no Fotos. %2$@ pede que você confirme %3$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相簿会在%1$@上删除；里面的照片和视频仍保留在图库中，和“照片”一样。%2$@会请你%3$@确认。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相簿會在%1$@上刪除；裡面的照片和影片仍保留在圖庫中，和「照片」一樣。%2$@會請你%3$@確認。"
          }
        }
      }
    },
    "The albums are deleted on %@; their photos and videos stay in the library, as in Photos. %@ asks you to confirm %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Alben werden auf %1$@ gelöscht; ihre Fotos und Videos bleiben in der Mediathek, wie in „Fotos“. %2$@ bittet dich, es %3$@ zu bestätigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los álbumes se eliminan en %1$@; sus fotos y vídeos siguen en la fototeca, como en Fotos. %2$@ te pedirá que lo confirmes %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les albums sont supprimés sur %1$@ ; leurs photos et vidéos restent dans la photothèque, comme dans Photos. %2$@ vous demandera de confirmer %3$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli album vengono eliminati su %1$@; le loro foto e i loro video restano nella libreria, come in Foto. %2$@ ti chiederà di confermare %3$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アルバムを%1$@で削除します。写真とビデオは「写真」と同じくライブラリに残ります。%2$@で%3$@確認を求められます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앨범들이 %1$@에서 삭제됩니다. 사진 앱처럼 앨범의 사진과 비디오는 보관함에 유지됩니다. %2$@에서 %3$@ 확인을 요청합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os álbuns são apagados em %1$@; as fotos e vídeos deles ficam na fototeca, como no Fotos. %2$@ pede que você confirme %3$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些相簿会在%1$@上删除；里面的照片和视频仍保留在图库中，和“照片”一样。%2$@会请你%3$@确认。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些相簿會在%1$@上刪除；裡面的照片和影片仍保留在圖庫中，和「照片」一樣。%2$@會請你%3$@確認。"
          }
        }
      }
    },
    "The App Store couldn't confirm this purchase. Please try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der App Store konnte diesen Kauf nicht bestätigen. Bitte versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El App Store no ha podido confirmar esta compra. Inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’App Store n’a pas pu confirmer cet achat. Veuillez réessayer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’App Store non ha potuto confermare questo acquisto. Riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Storeでこの購入を確認できませんでした。もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store에서 이 구입을 확인할 수 없습니다. 다시 시도하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A App Store não conseguiu confirmar esta compra. Tente novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store 无法确认此次购买，请重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store 無法確認此次購買，請再試一次。"
          }
        }
      }
    },
    "The backups are still on your Mac. Open Imago to delete them from your Mac too, keep them on your Mac, or put them back on %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Backups sind noch auf deinem Mac. Öffne Imago, um sie auch von deinem Mac zu löschen, sie auf deinem Mac zu behalten oder sie zurück auf %@ zu legen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las copias siguen en tu Mac. Abre Imago para eliminarlas también de tu Mac, conservarlas en tu Mac o devolverlas a %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sauvegardes sont toujours sur votre Mac. Ouvrez Imago pour les supprimer aussi de votre Mac, les garder sur votre Mac, ou les remettre sur %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I backup sono ancora sul tuo Mac. Apri Imago per eliminarli anche dal tuo Mac, tenerli sul tuo Mac o rimetterli su %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップはまだMacにあります。Imagoを開いて、Macからも削除するか、Macに残すか、%@に戻してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백업은 아직 Mac에 있습니다. Imago를 열어 Mac에서도 삭제하거나, Mac에 유지하거나, %@에 되돌려 놓으세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os backups continuam no seu Mac. Abra o Imago para apagá-los também do seu Mac, mantê-los no seu Mac ou devolvê-los a %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备份仍在你的 Mac 上。打开 Imago，可以也从 Mac 删除、在 Mac 上保留，或放回%@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "備份仍在你的 Mac 上。打開 Imago，可以也從 Mac 刪除、在 Mac 上保留，或放回%@。"
          }
        }
      }
    },
