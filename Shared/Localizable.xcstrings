        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feitas assim que chegam, incluindo itens novos. O iOS ainda pergunta antes de apagar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
