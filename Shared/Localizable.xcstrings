    "Imago is unlocked for your family. Thank you!" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imago ist für deine Familie freigeschaltet. Danke!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imago está desbloqueado para tu familia. ¡Gracias!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imago est déverrouillé pour votre famille. Merci !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imago è sbloccato per la tua famiglia. Grazie!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imagoはご家族向けにロック解除されています。ありがとうございます！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가족 모두 Imago 잠금이 해제되었습니다. 감사합니다!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Imago está desbloqueado para sua família. Obrigado!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imago 已为你的家人解锁。谢谢！"
