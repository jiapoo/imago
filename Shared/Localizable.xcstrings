          "stringUnit" : {
            "state" : "translated",
            "value" : "它已經在傳往 iPhone 的路上，或已在 iPhone 上。"
          }
        }
      }
    },
    "It's made on %@ right away." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wird sofort auf %@ ausgeführt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se hace en %@ al momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est fait sur %@ tout de suite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viene eseguita su %@ subito."
          }
        },
