    "Waiting to be deleted from the iPhone. You confirm it there, and they go to Recently Deleted on the iPhone. They stay on this Mac." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wartet darauf, vom iPhone gelöscht zu werden. Du bestätigst es dort, und sie kommen auf dem iPhone in „Zuletzt gelöscht“. Sie bleiben auf diesem Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendientes de eliminar del iPhone. Lo confirmas allí y van a Eliminado en el iPhone. Se quedan en este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En attente de suppression de l’iPhone. Vous confirmez là-bas, et ils vont dans Suppressions récentes sur l’iPhone. Ils restent sur ce Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In attesa di essere eliminati dall’iPhone. Confermi lì, e vanno in Eliminati di recente sull’iPhone. Restano su questo Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneからの削除待ちです。そちらで確認すると、iPhoneの「最近削除した項目」に入ります。このMacには残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone에서 삭제되기를 기다리고 있습니다. 그곳에서 확인하면 iPhone의 최근 삭제된 항목으로 이동합니다. 이 Mac에는 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguardando para serem apagados do iPhone. Você confirma lá, e eles vão para Apagados no iPhone. Eles ficam neste Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在等待从 iPhone 删除。你在那边确认后，它们会移到 iPhone 的“最近删除”。它们会保留在这台 Mac 上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在等待從 iPhone 刪除。你在那邊確認後，它們會移到 iPhone 的「最近刪除」。它們會保留在這部 Mac 上。"
          }
        }
      }
    },
