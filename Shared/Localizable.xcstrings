    "Preview only · not on the backup drive yet. Back up %@ to copy it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Vorschau · noch nicht auf dem Backup-Laufwerk. Sichere %@, um es zu kopieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo vista previa · aún no está en el disco de copias. Haz copia de %@ para copiarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aperçu seulement · pas encore sur le disque de sauvegarde. Sauvegardez %@ pour le copier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo anteprima · non ancora sul disco di backup. Fai il backup di %@ per copiarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレビューのみ · まだバックアップドライブにありません。コピーするには%@をバックアップしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미리보기만 · 아직 백업 드라이브에 없음. 복사하려면 %@을(를) 백업하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só pré-visualização · ainda não está no disco de backup. Faça backup de %@ para copiá-lo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅预览 · 尚未存到备份硬盘。备份%@即可拷贝它。"
