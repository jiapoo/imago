            "value" : "La última copia no terminó"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dernière sauvegarde n’est pas terminée"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ultimo backup non è terminato"
          }
        },
