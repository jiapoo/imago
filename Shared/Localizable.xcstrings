    "Removing it from the %@ frees %@ there. The backup on this drive stays." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du es vom %1$@ entfernst, werden dort %2$@ frei. Das Backup auf diesem Laufwerk bleibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quitarlo del %1$@ libera %2$@ allí. La copia de este disco se queda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le retirer de l’%1$@ y libère %2$@. La sauvegarde sur ce disque reste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuoverlo dall’%1$@ libera %2$@ lì. Il backup su questo disco resta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@から取り除くと、そちらで%2$@空きます。このドライブのバックアップは残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@에서 제거하면 그곳에 %2$@가 확보됩니다. 이 드라이브의 백업은 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removê-lo do %1$@ libera %2$@ lá. O backup neste disco fica."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从%1$@移除它可在那边腾出 %2$@。这个硬盘上的备份会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從%1$@移除它可在那邊釋放 %2$@。這個硬碟上的備份會保留。"
          }
        }
      }
    },
    "Removing them from the %@ frees %@ there. The backups on this drive stay." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du sie vom %1$@ entfernst, werden dort %2$@ frei. Die Backups auf diesem Laufwerk bleiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quitarlos del %1$@ libera %2$@ allí. Las copias de este disco se quedan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les retirer de l’%1$@ y libère %2$@. Les sauvegardes sur ce disque restent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuoverli dall’%1$@ libera %2$@ lì. I backup su questo disco restano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@から取り除くと、そちらで%2$@空きます。このドライブのバックアップは残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@에서 제거하면 그곳에 %2$@가 확보됩니다. 이 드라이브의 백업은 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removê-los do %1$@ libera %2$@ lá. Os backups neste disco ficam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
