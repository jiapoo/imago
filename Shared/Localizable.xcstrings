    "Photos already on the Mac stay there. You can pair again anytime." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos, die schon auf dem Mac sind, bleiben dort. Du kannst jederzeit erneut koppeln."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fotos que ya están en el Mac se quedan allí. Puedes volver a enlazar cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les photos déjà sur le Mac y restent. Vous pouvez rejumeler à tout moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le foto già sul Mac restano lì. Puoi abbinare di nuovo quando vuoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すでにMacにある写真はそのまま残ります。いつでも再ペアリングできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 Mac에 있는 사진은 그대로 유지됩니다. 언제든지 다시 페어링할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As fotos que já estão no Mac ficam lá. Você pode emparelhar de novo quando quiser."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已在 Mac 上的照片会保留。你随时可以重新配对。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已在 Mac 上的照片會保留。你隨時可以重新配對。"
          }
        }
      }
    },
    "Photos and videos appear here as your iPhones back up." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos und Videos erscheinen hier, während deine iPhones sichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fotos y vídeos aparecen aquí a medida que tus iPhone hacen copia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les photos et vidéos apparaissent ici à mesure que vos iPhone sauvegardent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto e video compaiono qui man mano che i tuoi iPhone fanno il backup."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneがバックアップすると、ここに写真とビデオが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone이 백업하면 여기에 사진과 비디오가 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As fotos e vídeos aparecem aqui conforme seus iPhones fazem backup."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 iPhone 备份后，照片和视频会显示在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 iPhone 備份後，照片和影片會顯示在這裡。"
          }
        }
      }
    },
    "Photos and videos deleted on the iPhone after they were backed up show here, as of its last backup." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos und Videos, die nach der Sicherung auf dem iPhone gelöscht wurden, erscheinen hier, Stand seiner letzten Sicherung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí aparecen las fotos y vídeos eliminados en el iPhone después de tener copia, según su última copia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les photos et vidéos supprimées sur l’iPhone après leur sauvegarde apparaissent ici, d’après sa dernière sauvegarde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui compaiono foto e video eliminati sull’iPhone dopo il backup, secondo il suo ultimo backup."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップ後にiPhoneで削除された写真とビデオが、最終バックアップ時点の情報でここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백업된 후 iPhone에서 삭제된 사진과 비디오가 마지막 백업 기준으로 여기에 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As fotos e vídeos apagados no iPhone depois do backup aparecem aqui, conforme o último backup dele."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备份后在 iPhone 上删除的照片和视频会显示在这里，以它的上次备份为准。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "備份後在 iPhone 上刪除的照片和影片會顯示在這裡，以它的上次備份為準。"
          }
        }
      }
    },
    "Photos and videos over %@ show here, biggest first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos und Videos über %@ erscheinen hier, die größten zuerst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí aparecen las fotos y vídeos de más de %@, los más grandes primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les photos et vidéos de plus de %@ apparaissent ici, les plus grosses en premier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui compaiono foto e video oltre %@, i più grandi per primi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@を超える写真とビデオが、大きい順にここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@보다 큰 사진과 비디오가 큰 순서대로 여기에 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As fotos e vídeos acima de %@ aparecem aqui, os maiores primeiro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大于 %@ 的照片和视频会显示在这里，从大到小。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大於 %@ 的照片和影片會顯示在這裡，由大到小。"
          }
        }
      }
    },
    "Photos and videos taken on %@ in earlier years show here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos und Videos, die in früheren Jahren am %@ aufgenommen wurden, erscheinen hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí aparecen las fotos y vídeos tomados un %@ de años anteriores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les photos et vidéos prises un %@ les années précédentes apparaissent ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui compaiono foto e video scattati il %@ negli anni passati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "過去の年の%@に撮影された写真とビデオがここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지난 몇 년 동안 %@에 찍은 사진과 비디오가 여기에 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As fotos e vídeos tirados em %@ de anos anteriores aparecem aqui."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
