    "\" xml:space=\"preserve\">\n        <source/>\n        <note/>\n      </trans-unit>\n      <trans-unit id=" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nKlicke, um eines im Finder anzuzeigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nHaz clic para mostrar uno en el Finder."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nCliquez pour en afficher un dans le Finder."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nFai clic per mostrarne uno nel Finder."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nクリックするとFinderに表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n클릭하면 Finder에서 하나를 보여줍니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nClique para mostrar um no Finder."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n点按以在“访达”中显示其中一个。"
