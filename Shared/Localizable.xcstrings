    "On your Mac, click **Copy Link** in Add iPhone, then paste it here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke auf deinem Mac in „iPhone hinzufügen“ auf **Link kopieren** und setze ihn hier ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tu Mac, haz clic en **Copiar enlace** en Añadir iPhone y pégalo aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur votre Mac, cliquez sur **Copier le lien** dans Ajouter un iPhone, puis collez-le ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sul tuo Mac, fai clic su **Copia link** in Aggiungi iPhone, poi incollalo qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macの「iPhoneを追加」で**リンクをコピー**をクリックし、ここに貼り付けてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac의 iPhone 추가에서 **링크 복사하기**를 클릭한 다음 여기에 붙여넣으세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No seu Mac, clique em **Copiar Link** em Adicionar iPhone e cole aqui."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
