    },
    "Your free trial has %lld days left. Unlock once to keep backing up new photos and videos." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Gratis-Test läuft noch %lld Tage. Schalte einmal frei, um neue Fotos und Videos weiter zu sichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tu prueba gratuita le quedan %lld días. Desbloquea una vez para seguir haciendo copia de las fotos y vídeos nuevos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il reste %lld jours à votre essai gratuit. Déverrouillez une fois pour continuer à sauvegarder les nouvelles photos et vidéos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla tua prova gratuita mancano %lld giorni. Sblocca una volta per continuare il backup di nuove foto e video."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無料トライアルは残り%lld日です。一度ロックを解除すれば、新しい写真とビデオのバックアップを続けられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무료 체험이 %lld일 남았습니다. 한 번 잠금 해제하면 새 사진과 비디오를 계속 백업합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restam %lld dias no seu teste grátis. Desbloqueie uma vez para continuar fazendo backup de novas fotos e vídeos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免费试用还剩 %lld 天。一次性解锁，即可继续备份新的照片和视频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免費試用還剩 %lld 天。一次性解鎖，即可繼續備份新的照片和影片。"
          }
        }
      }
    },
