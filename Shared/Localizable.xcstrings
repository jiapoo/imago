    "Keep every backup here, put them all back on %@, or move them all to Recently Deleted" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Backup hier behalten, alle zurück auf %@ legen oder alle in „Zuletzt gelöscht“ bewegen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservar aquí todas las copias, devolverlas todas a %@ o pasarlas todas a Eliminado"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garder toutes les sauvegardes ici, les remettre toutes sur %@, ou les placer toutes dans Suppressions récentes"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni qui ogni backup, rimettili tutti su %@ o spostali tutti in Eliminati di recente"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここにすべてのバックアップを残すか、すべて%@に戻すか、すべて「最近削除した項目」に移します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기 있는 모든 백업을 유지하거나, 모두 %@에 되돌려 놓거나, 모두 최근 삭제된 항목으로 이동합니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manter todos os backups aqui, devolver todos a %@ ou mover todos para Apagados"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留这里的所有备份、全部放回%@，或全部移到“最近删除”"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留這裡的所有備份、全部放回%@，或全部移到「最近刪除」"
          }
        }
      }
    },
    "Keep Imago open; your %@ won't lock while it backs up. If anything stops it, it picks up where it left off." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass Imago geöffnet; dein %@ sperrt sich nicht, während es sichert. Wenn etwas unterbricht, macht es dort weiter, wo es aufgehört hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén Imago abierto; tu %@ no se bloqueará mientras hace la copia. Si algo la detiene, seguirá donde se quedó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez Imago ouvert ; votre %@ ne se verrouillera pas pendant la sauvegarde. Si quelque chose l’interrompt, elle reprend là où elle s’est arrêtée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni aperto Imago; il tuo %@ non si bloccherà durante il backup. Se qualcosa lo interrompe, riprende da dove si era fermato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imagoを開いたままにしてください。バックアップ中は%@がロックされません。途中で止まっても、止まったところから続きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imago를 열어 두세요. 백업하는 동안 %@이(가) 잠기지 않습니다. 중간에 멈추면 멈춘 곳부터 이어집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha o Imago aberto; seu %@ não vai bloquear durante o backup. Se algo interromper, ele continua de onde parou."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请保持 Imago 打开；备份时你的%@不会锁定。如果中途停下，会从中断处继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請保持 Imago 打開；備份時你的%@不會鎖定。如果中途停下，會從中斷處繼續。"
          }
        }
      }
    },
