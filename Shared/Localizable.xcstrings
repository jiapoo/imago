    "Backed up here, but deleted on %@ since" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier gesichert, aber seitdem auf %@ gelöscht"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con copia aquí, pero eliminado en %@ desde entonces"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauvegardé ici, mais supprimé depuis sur %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con backup qui, ma eliminato da allora su %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここにバックアップ済みですが、その後%@で削除されました"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기에 백업되었지만 그 후 %@에서 삭제됨"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com backup aqui, mas apagado em %@ desde então"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已备份在这里，但之后在%@上被删除"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已備份在這裡，但之後在%@上被刪除"
          }
        }
      }
    },
    "Backed up on this Mac, but deleted on the iPhone since. Delete them from this Mac too, keep the backups on this Mac, or put them back on the iPhone (right-click, or Decide for All). They stay until you decide." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Mac gesichert, aber seitdem auf dem iPhone gelöscht. Lösche sie auch von diesem Mac, behalte die Backups auf diesem Mac oder lege sie zurück aufs iPhone (Rechtsklick oder „Für alle entscheiden“). Sie bleiben, bis du entscheidest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con copia en este Mac, pero eliminados en el iPhone desde entonces. Elimínalos también de este Mac, conserva las copias en este Mac o devuélvelos al iPhone (clic derecho o Decidir para todos). Se quedan hasta que decidas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauvegardés sur ce Mac, mais supprimés depuis sur l’iPhone. Supprimez-les aussi de ce Mac, gardez les sauvegardes sur ce Mac ou remettez-les sur l’iPhone (clic droit ou Décider pour tous). Ils restent jusqu’à votre décision."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con backup su questo Mac, ma eliminati da allora sull’iPhone. Eliminali anche da questo Mac, tieni i backup su questo Mac o rimettili sull’iPhone (clic destro o Decidi per tutti). Restano finché non decidi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacにバックアップ済みですが、その後iPhoneで削除されました。このMacからも削除するか、このMacにバックアップを残すか、iPhoneに戻します（右クリック、または「すべてについて決める」）。決めるまで残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac에 백업되었지만 그 후 iPhone에서 삭제되었습니다. 이 Mac에서도 삭제하거나, 이 Mac에 백업을 유지하거나, iPhone에 되돌려 놓으세요(오른쪽 클릭 또는 모두에 대해 결정). 결정할 때까지 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com backup neste Mac, mas apagados no iPhone desde então. Apague-os também deste Mac, mantenha os backups neste Mac ou devolva-os ao iPhone (clique com o botão direito ou Decidir para Todos). Eles ficam até você decidir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已备份在这台 Mac 上，但之后在 iPhone 上被删除。你可以也从这台 Mac 删除、在这台 Mac 上保留备份，或把它们放回 iPhone（右键点按，或“全部决定”）。在你决定之前会一直保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已備份在這部 Mac 上，但之後在 iPhone 上被刪除。你可以也從這部 Mac 刪除、在這部 Mac 上保留備份，或把它們放回 iPhone（按一下右鍵，或「全部決定」）。在你決定之前會一直保留。"
          }
        }
      }
    },
    "Backed up on this Mac, but deleted on the iPhone since. Delete them from this Mac too, keep the backups on this Mac, or put them back on the iPhone (right-click, or Decide for All). Undecided, each moves to Recently Deleted %lld days after it left the iPhone (the days on each)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Mac gesichert, aber seitdem auf dem iPhone gelöscht. Lösche sie auch von diesem Mac, behalte die Backups auf diesem Mac oder lege sie zurück aufs iPhone (Rechtsklick oder „Für alle entscheiden“). Ohne Entscheidung kommt jedes %lld Tage, nachdem es das iPhone verlassen hat, in „Zuletzt gelöscht“ (die Tage stehen an jedem)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con copia en este Mac, pero eliminados en el iPhone desde entonces. Elimínalos también de este Mac, conserva las copias en este Mac o devuélvelos al iPhone (clic derecho o Decidir para todos). Si no decides, cada uno pasa a Eliminado %lld días después de salir del iPhone (los días se ven en cada uno)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauvegardés sur ce Mac, mais supprimés depuis sur l’iPhone. Supprimez-les aussi de ce Mac, gardez les sauvegardes sur ce Mac ou remettez-les sur l’iPhone (clic droit ou Décider pour tous). Sans décision, chacun va dans Suppressions récentes %lld jours après avoir quitté l’iPhone (les jours sont indiqués sur chacun)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con backup su questo Mac, ma eliminati da allora sull’iPhone. Eliminali anche da questo Mac, tieni i backup su questo Mac o rimettili sull’iPhone (clic destro o Decidi per tutti). Senza decisione, ognuno va in Eliminati di recente %lld giorni dopo aver lasciato l’iPhone (i giorni sono indicati su ciascuno)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacにバックアップ済みですが、その後iPhoneで削除されました。このMacからも削除するか、このMacにバックアップを残すか、iPhoneに戻します（右クリック、または「すべてについて決める」）。決めないままだと、それぞれiPhoneから消えて%lld日後に「最近削除した項目」に移ります（日数は各項目に表示）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac에 백업되었지만 그 후 iPhone에서 삭제되었습니다. 이 Mac에서도 삭제하거나, 이 Mac에 백업을 유지하거나, iPhone에 되돌려 놓으세요(오른쪽 클릭 또는 모두에 대해 결정). 결정하지 않으면 각 항목은 iPhone에서 사라진 지 %lld일 후에 최근 삭제된 항목으로 이동합니다(각 항목에 날짜 표시)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com backup neste Mac, mas apagados no iPhone desde então. Apague-os também deste Mac, mantenha os backups neste Mac ou devolva-os ao iPhone (clique com o botão direito ou Decidir para Todos). Sem decisão, cada um vai para Apagados %lld dias depois de sair do iPhone (os dias aparecem em cada um)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已备份在这台 Mac 上，但之后在 iPhone 上被删除。你可以也从这台 Mac 删除、在这台 Mac 上保留备份，或把它们放回 iPhone（右键点按，或“全部决定”）。如果不决定，每一项会在离开 iPhone %lld 天后移到“最近删除”（每项上都标有天数）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已備份在這部 Mac 上，但之後在 iPhone 上被刪除。你可以也從這部 Mac 刪除、在這部 Mac 上保留備份，或把它們放回 iPhone（按一下右鍵，或「全部決定」）。如果不決定，每一項會在離開 iPhone %lld 天後移到「最近刪除」（每項上都標有天數）。"
          }
        }
      }
    },
