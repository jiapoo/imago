    "Stop after the file under way. What's done stays, and Undo takes it back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach der laufenden Datei anhalten. Was erledigt ist, bleibt, und „Widerrufen“ nimmt es zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parar tras el archivo en curso. Lo hecho se queda, y Deshacer lo revierte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’arrêter après le fichier en cours. Ce qui est fait reste, et Annuler le reprend."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fermati dopo il file in corso. Ciò che è fatto resta, e Annulla lo riporta indietro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "処理中のファイルの後で止めます。終わった分は残り、「取り消す」で元に戻せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "진행 중인 파일 다음에 멈춥니다. 끝난 것은 유지되며 실행 취소로 되돌릴 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parar depois do arquivo em andamento. O que foi feito fica, e Desfazer reverte."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "处理完当前文件后停止。已完成的会保留，“撤销”可以还原。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "處理完目前的檔案後停止。已完成的會保留，「還原」可以復原。"
          }
        }
      }
    },
